# ============================================================
# 跨境物流规则智能Agent - 环境变量模板
# 复制为 .env 后填入真实值，.env 已被 .gitignore 排除
# ============================================================

# ---------- 模型服务 (OpenAI 兼容 / Qwen) ----------
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL_NAME=Qwen3.8-27B
LLM_API_KEY=your-api-key-here
# LLM 提供方：local=本地/自建 llama.cpp（默认）；接云端改为对应值即可（deepseek / doubao / openai）
LLM_PROVIDER=local
# 思考强度（可选）：留空=保持现有行为；llama.cpp 支持 minimal|low|medium|high|xhigh，
# OpenAI 推理模型（o3/gpt-5）支持 low|medium|high；接非推理模型（gpt-4o/DeepSeek/豆包）请留空
LLM_REASONING_EFFORT=
# 云端输出预算封顶（仅 LLM_PROVIDER 非 local 时生效）：DeepSeek/豆包 8192，OpenAI gpt-4o 16384
LLM_CLOUD_MAX_TOKENS=8192
# ---- 云端配置示例（按所用厂商取消注释并替换上面的 LLM_* 三行）----
# DeepSeek：
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat
# LLM_API_KEY=sk-...
# 豆包（火山方舟）：
# LLM_PROVIDER=doubao
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL_NAME=ep-xxxxxxxx            # 方舟接入点 ID（或模型名）
# LLM_API_KEY=...
# OpenAI：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o
# LLM_API_KEY=sk-...

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=cross_border_agent

# ---------- Milvus Lite ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=customs_rule_v1
# 向量库连接 URI（Milvus Lite 本地文件或 server 地址）
MILVUS_DB_URI=logs/milvus.db

# ---------- 向量化 / Rerank / HyDE ----------
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLE=true
RERANK_TOP_K=5

# ---------- MinIO ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------- 降级开关 ----------
HYDE_ENABLE=true
SMART_SUMMARY_ENABLE=true
LLM_CHECK_ENABLE=true
# 工作流自动追问补全参数
FOLLOW_UP_ENABLE=true
# 并发活跃请求超阈值自动降级
DEGRADE_MAX_ACTIVE=4

# ---------- 爬虫服务 (AI爬虫) ----------
SPIDER_ENV=test
# SPIDER_USER_AGENT=  # 自定义 User-Agent
# SPIDER_REQUEST_TIMEOUT=30
# SPIDER_REQUEST_DELAY_SEC=2.0
# SPIDER_CRAWL_INTERVAL_MIN=1440
# SPIDER_MAX_AI_REPAIR_COUNT=3
SPIDER_TRANSLATE_ENABLE=true
SPIDER_AI_REPAIR_ENABLE=true
# SPIDER_AI_TEXT_LIMIT=8000
# SPIDER_CHANGE_FULL_THRESHOLD=0.5
