# ============================================================
# 跨境物流规则智能Agent - 环境变量模板
# 复制为 .env 后填入真实值，.env 已被 .gitignore 排除
# ============================================================

# ---------- 模型服务 (OpenAI 兼容 / Qwen) ----------
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL_NAME=Qwen3.8-27B
LLM_API_KEY=your-api-key-here

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=cross_border_agent

# ---------- Milvus Lite ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=customs_rule_v1
# 向量库连接 URI（Milvus Lite 本地文件或 server 地址）
MILVUS_DB_URI=logs/milvus.db

# ---------- 向量化 / Rerank / HyDE ----------
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLE=true
RERANK_TOP_K=5

# ---------- MinIO ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------- 降级开关 ----------
HYDE_ENABLE=true
SMART_SUMMARY_ENABLE=true
LLM_CHECK_ENABLE=true
# 工作流自动追问补全参数
FOLLOW_UP_ENABLE=true
# 并发活跃请求超阈值自动降级
DEGRADE_MAX_ACTIVE=4

# ---------- 爬虫服务 (AI爬虫) ----------
SPIDER_ENV=test
# SPIDER_USER_AGENT=  # 自定义 User-Agent
# SPIDER_REQUEST_TIMEOUT=30
# SPIDER_REQUEST_DELAY_SEC=2.0
# SPIDER_CRAWL_INTERVAL_MIN=1440
# SPIDER_MAX_AI_REPAIR_COUNT=3
SPIDER_TRANSLATE_ENABLE=true
SPIDER_AI_REPAIR_ENABLE=true
# SPIDER_AI_TEXT_LIMIT=8000
# SPIDER_CHANGE_FULL_THRESHOLD=0.5
